rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own subtree: users/{uid}/...
    // (Server routes use the Admin SDK, which bypasses these rules after verifying the user's token.)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
