rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own subtree: users/{uid}/...
    // EXCEPT users/{uid}/private/** (Google OAuth tokens) — server-only, never readable by clients.
    // (Server routes use the Admin SDK, which bypasses these rules after verifying the user's token.)
    match /users/{uid}/{collection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid && collection != 'private';
    }
  }
}
